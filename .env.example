# =============================================================================
# MRMS Environment Variables (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy to `.env` (scripts/setup.* does this) and fill in real values.
# NEVER commit a real .env. Only this .env.example (placeholders) is committed.
# See docs/CONFIGURATION.md and docs/SECRETS.md, and
# docs/standards/environment-variable-convention.md.
# =============================================================================

# --- App ---------------------------------------------------------------------
APP_ENV=development                 # development | staging | production
APP_PORT=3000                       # backend API port
APP_BASE_URL=http://localhost:3000  # public base URL of the API
APP_TIMEZONE=Asia/Makassar          # default display timezone (per-site overrides in DB)
APP_LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace
WEB_HTTP_PORT=8080                  # host port mapped to the web (nginx) container
# Comma-separated browser origins allowed by CORS (Admin + Display dev servers).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_USER=mrms
DATABASE_PASSWORD=change_me         # SECRET - do not use in production as-is
DATABASE_NAME=mrms
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Full connection string used by Prisma (compose builds it from the parts above).
DATABASE_URL=postgresql://mrms:change_me@localhost:5432/mrms?schema=public

# --- Redis -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- JWT / Auth --------------------------------------------------------------
# RS256 recommended: provide PEM keys via secret store, not inline in prod.
JWT_PRIVATE_KEY=                    # SECRET (PEM) - leave empty here
JWT_PUBLIC_KEY=                     # PEM public key for verification
JWT_ACCESS_TTL=15m                  # access token lifetime
JWT_REFRESH_TTL=7d                  # refresh token lifetime
JWT_ISSUER=mrms
JWT_AUDIENCE=mrms-clients

# --- Google OAuth + Calendar -------------------------------------------------
GOOGLE_CLIENT_ID=                   # OAuth client id
GOOGLE_CLIENT_SECRET=               # SECRET - OAuth client secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=mitraprodin.com   # comma-separated allowed Workspace domains
# Bootstrap administrator email (reserved; consumed by the OAuth flow in Sprint 1B).
ADMIN_BOOTSTRAP_EMAIL=
# Service credentials for reading resource calendars + creating events.
# Provide the path to a mounted service-account JSON (NEVER commit the file),
# or supply the delegated-user email if using domain-wide delegation.
GOOGLE_SERVICE_ACCOUNT_JSON=        # SECRET path, e.g. /run/secrets/gcal-sa.json
GOOGLE_DELEGATED_USER=              # optional: user email for domain-wide delegation
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.readonly,https://www.googleapis.com/auth/calendar.events

# --- Calendar Sync tuning ----------------------------------------------------
SYNC_INTERVAL_SECONDS=60            # baseline/fallback poll cadence
SYNC_WINDOW_DAYS=14                 # how far ahead to cache events
SYNC_USE_WATCH_CHANNELS=true        # use Google push notifications when available
SYNC_WATCH_RENEW_LEAD_MINUTES=60    # renew watch channels before expiry

# --- Meeting timing (also seeded into DB Settings; env are defaults) ---------
STARTING_SOON_LEAD_MINUTES=10       # window before start to show "Starting Soon"
NO_SHOW_GRACE_MINUTES=15            # auto-release + no-show grace period
JOIN_AUTO_CLOSE_GRACE_MINUTES=5     # grace after endTime before returning to display

# --- Device / Kiosk monitoring ----------------------------------------------
DEVICE_HEARTBEAT_INTERVAL_SECONDS=30
DEVICE_OFFLINE_THRESHOLD_SECONDS=120   # missed-heartbeat window before OFFLINE
DEVICE_TOKEN_SALT=                     # SECRET - salt/pepper for hashing device tokens

# --- Feature toggles ---------------------------------------------------------
ENABLE_ZOOM=true

# --- Frontend (Vite build-time, PUBLIC only - never secrets) -----------------
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_WS_URL=ws://localhost:3000/realtime

# --- Local tooling (docker-compose.dev only) ---------------------------------
PGADMIN_EMAIL=admin@mitraprodin.com
PGADMIN_PASSWORD=admin              # dev only - never use in production
PGADMIN_PORT=5050
