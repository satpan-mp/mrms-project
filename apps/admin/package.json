  "private": true,
  "description": "MRMS Admin Panel SPA (React + Vite): configuration, monitoring, analytics.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
