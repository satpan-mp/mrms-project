{
  "name": "mrms-project",
  "version": "0.1.0",
  "private": true,
  "description": "Meeting Room Management System (MRMS) for PT Mitra Prodin - enterprise meeting room display & booking platform integrated with Google Workspace.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "lint:fix": "pnpm -r --if-present run lint:fix",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:cov": "pnpm -r --if-present run test:cov",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,cjs,json,md,yml,yaml}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,cjs,json,md,yml,yaml}\"",
    "dev:backend": "pnpm --filter @mrms/backend run start:dev",
    "dev:display": "pnpm --filter @mrms/display run dev",
    "dev:admin": "pnpm --filter @mrms/admin run dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.4.0",
    "husky": "^9.1.5",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
