{
  "name": "@mrms/ui",
  "version": "0.1.0",
  "private": true,
  "description": "MRMS shared, theme-aware component library implementing the approved Design System (Google Workspace-inspired, accessible, TV-optimized).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles/tokens.css": "./src/styles/tokens.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@mrms/types": "workspace:*",
    "@phosphor-icons/react": "^2.1.7",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.2"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@mrms/config": "workspace:*",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
