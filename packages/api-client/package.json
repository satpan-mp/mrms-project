{
  "name": "@mrms/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed REST client for the MRMS backend. Sprint 1A ships the client core + system endpoints; resource endpoints are added per sprint (generated from OpenAPI).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@mrms/types": "workspace:*",
    "axios": "^1.7.7"
  },
  "devDependencies": {
    "@mrms/config": "workspace:*",
    "eslint": "^8.57.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
