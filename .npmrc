# pnpm configuration for the MRMS monorepo.
# Hoist framework/tooling patterns so NestJS/Vite/Prisma resolve plugins reliably
# while keeping the default strict node_modules for everything else.
auto-install-peers=true
strict-peer-dependencies=false
resolution-mode=highest
prefer-workspace-packages=true
link-workspace-packages=true
# Prisma + esbuild + swc need their native/postinstall scripts to run.
enable-pre-post-scripts=true
